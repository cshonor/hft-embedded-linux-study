{
  "version": 3,
  "comment": "把常用的配置组合固化下来：cmake --preset <名字> 一条命令到位",
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "开发机：Debug + ASan + UBSan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "bench",
      "displayName": "压测机：RelWithDebInfo + -O3 -march=native + LTO",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "prod",
      "displayName": "上线：Release（-march 按线上 CPU 在 toolchain/CI 里显式指定）",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/prod",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
