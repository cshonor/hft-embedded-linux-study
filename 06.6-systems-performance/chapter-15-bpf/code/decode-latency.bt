/* decode-latency.bt — uprobe/uretprobe 测用户态函数延迟直方图（ch15 §15.1.7 块1、§15.2 块6）
 *
 * 用法: sudo bpftrace decode-latency.bt /opt/strategy decode
 *   $1 = 二进制路径（uprobe 目标），$2 = 函数名
 * 原理: uprobe 记入线程入场时间戳 → uretprobe 求差 → hist 聚合
 * 要点: @start[tid] 用完必须 delete，否则 map 泄漏 + 重复入场错位
 */

uprobe:$1:$2 { @start[tid] = nsecs; }

uretprobe:$1:$2 /@start[tid]/ {
    @decode_us = hist((nsecs - @start[tid]) / 1000);
    delete(@start[tid]);
}

interval:s:10 { print(@decode_us); clear(@decode_us); }
