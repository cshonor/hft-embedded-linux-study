#!/usr/bin/env bpftrace
/* blk-plug-latency.bt — 块 I/O plug（蓄流）时间直方图（02-ch09 §8 块5）
 *
 * plug 是块层的"攒一批再发"机制：blk_start_plug → blk_finish_plug。
 * 蓄流时间长 = 吞吐友好、延迟不友好——日志盘 tail 的一个来源。
 *
 * ⚠ 内核 7.0 适配（2026-10 本机实测）：原配对的 blk_flush_plug_list
 * 已不存在（被内联进 blk_finish_plug），改用 start/finish 配对——
 * 语义从"flush 队列耗时"变为"整个 plug 窗口持有时长"，反而更直观。
 *
 * 配对键用 arg0（plug 对象指针）而不是 tid——
 * start 和 finish 可能不在同一线程执行（这是块层配对特别容易踩的点）。
 *
 * 用法: sudo bpftrace blk-plug-latency.bt
 */

kprobe:blk_start_plug
{
    @ts[arg0] = nsecs;
}

kprobe:blk_finish_plug
/@ts[arg0] != 0/
{
    @plug_ns = hist(nsecs - @ts[arg0]);
    delete(@ts[arg0]);
}

END { clear(@ts); }
