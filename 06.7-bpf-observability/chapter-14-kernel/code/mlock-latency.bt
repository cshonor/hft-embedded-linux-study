#!/usr/bin/env bpftrace
/* mlock-latency.bt — 内核 mutex 等待直方图（02-ch14 §5 块2）
 *
 * mutex_lock 入口记时刻+锁地址，返回时求差 = 等锁花了多久。
 * 按 [锁符号, 内核栈(5), comm] 聚合 → 哪把锁、哪条路径、哪个进程在争。
 *
 * 用法: sudo bpftrace mlock-latency.bt
 * 对照: 06.6/ch13 的 perf lock（另一套观测口径）
 */

kprobe:mutex_lock,
kprobe:mutex_lock_interruptible
{
    @lock_start[tid] = nsecs;
    @lock_addr[tid] = arg0;
}

kretprobe:mutex_lock
/@lock_start[tid]/
{
    @lock_latency_ns[ksym(@lock_addr[tid]), kstack(5), comm]
        = hist(nsecs - @lock_start[tid]);
    delete(@lock_start[tid]);
    delete(@lock_addr[tid]);
}

END
{
    clear(@lock_start); clear(@lock_addr); clear(@lock_latency_ns);
}
