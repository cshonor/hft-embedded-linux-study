#!/usr/bin/env bpftrace
/* slab-name.bt — slab 分配热点（02-ch14 §6 块5）
 *
 * 原版 kprobe:kmem_cache_alloc 在内核 7.0 已没有可 attach 的符号
 * （被内联，kallsyms 只剩 trace 桩；2026-10 本机实测）——
 * 改用稳定 ABI tracepoint:kmem:kmem_cache_alloc。
 *
 * 代价：tracepoint 不带 kmem_cache*，拿不到 cache name（kmalloc-4k 等）；
 * 改为按 call_site（调用方内核地址，可用 /proc/kallsyms 反查符号）+
 * gfp_flags 聚合——"哪个调用点在猛分配"比"哪个 cache"通常更有用。
 * 要 cache name 总览请用 slabtop（§6 块3）。
 *
 * 用法: sudo bpftrace slab-name.bt
 */

tracepoint:kmem:kmem_cache_alloc
{
    @[ksym(args->call_site), args->gfp_flags] = count();
}

interval:s:5
{
    time();
    print(@, 10);
    clear(@);
}

END { clear(@); }
