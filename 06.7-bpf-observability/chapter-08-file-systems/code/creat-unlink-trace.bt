#!/usr/bin/env bpftrace
/* creat-unlink-trace.bt — 文件创建/删除追踪（02-ch08 §10 块1）
 *
 * 附带"寿命"统计：creat 记时间戳，unlink 时求差 = 文件存活时长
 * （filelife-bpfcc 的简化版）。
 *
 * ⚠ 局限（笔记原话）：tracepoint 看不到内核内部路径的 unlink（如 tmpfs 自动清理），
 *   且 creat 是 open(O_CREAT) 的古董变体——生产代码多走 openat。
 *
 * 用法: sudo bpftrace creat-unlink-trace.bt
 */

tracepoint:syscalls:sys_enter_creat /comm != "bpftrace"/
{
    printf("%s create %s\n", comm, str(args->pathname));
    @born[str(args->pathname)] = nsecs;
}

tracepoint:syscalls:sys_enter_unlink
{
    $p = str(args->pathname);
    printf("%s unlink %s\n", comm, $p);
    $t0 = @born[$p];
    if ($t0) {
        printf("  存活 %llu ms\n", (nsecs - $t0) / 1000000);
        delete(@born[$p]);
    }
}

END { clear(@born); }
