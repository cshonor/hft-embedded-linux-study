#!/usr/bin/env bpftrace
/* fd-leak-watch.bt — fd 泄漏看门狗（02-ch08 §10 块3，可选练习答案）
 *
 * alloc_fd 记账、close_fd 销账，每 10 秒打印"仍在账上"的记录——
 * 悬账持续增长的 tid = 泄漏线程。
 * 完整版可配 kretprobe:alloc_fd 拿 retval（FD 号），此处保持书上骨架。
 *
 * 用法: sudo bpftrace fd-leak-watch.bt
 */

kprobe:alloc_fd  { @open[tid] = nsecs; }          /* 记账 */
kprobe:close_fd  { delete(@open[tid]); }          /* 销账 */

interval:s:10
{
    print(@open);                                  /* 周期性打印"仍在账上"的 */
    clear(@open);
}

END { clear(@open); }
