#!/usr/bin/env bpftrace
/* vfs-read-by-file.bt — 按文件名统计 read（02-ch08 §3 块4）
 *
 * read(2) 只有 fd 号没有路径；从 task_struct → files → fdtable 反查
 * struct file → dentry 名——这是"fd 反查文件名"的标准链路。
 *
 * 用法: sudo bpftrace vfs-read-by-file.bt
 */

/* 不 #include linux/sched.h|fdtable.h|fs.h：内核 7.0 头 static_assert 解析失败；
 * task→files→fdt→file→dentry 的链路全部走 BTF（2026-10 实测修复） */

tracepoint:syscalls:sys_enter_read
{
    $task = (struct task_struct *)curtask;
    $file = (struct file *)*($task->files->fdt->fd + args->fd);
    @filename[str($file->f_path.dentry->d_name.name)] = count();
}
