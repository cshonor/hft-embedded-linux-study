#!/usr/bin/env bpftrace
/* vfs_read_latency.bt — vfs_read 耗时直方图（02-ch05 §7 块8，书上第一个完整程序）
 *
 * 用法: sudo bpftrace vfs_read_latency.bt
 *       或 chmod +x 后 sudo ./vfs_read_latency.bt
 *
 * 配对三件套（§17 块7，防 bug 的标准形态）：
 *   ① 出口侧 /@start[tid]/ 过滤 —— 没有入口记录的出口直接丢
 *   ② 用完 delete(@start[tid])  —— 防 tid 复用串味
 *   ③ 先删后聚合               —— 删漏的下次也被过滤挡住
 */

kprobe:vfs_read
{
    @start[tid] = nsecs;
}

kretprobe:vfs_read
/@start[tid]/
{
    $duration_us = (nsecs - @start[tid]) / 1000;
    @us = hist($duration_us);
    delete(@start[tid]);
}

END
{
    clear(@start);
}
