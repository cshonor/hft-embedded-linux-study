/* open-trace.bt — open/openat 入口出口配对追踪（ch10 §10.1 块2）
 *
 * 用法: sudo bpftrace open-trace.bt
 * 输出: pid comm fd errno filename（open 失败时 errno 非零）
 *
 * 形态要点（bpftrace 编程的通用三招）：
 *   ① 一个 action 挂多个事件（逗号列表）——open/openat 逻辑复用
 *   ② 入口存参数 @[tid]，出口 /@x[tid]/ 过滤后取用——entry/exit 配对
 *   ③ 用完 delete(@x[tid])——否则 map 泄漏 + 同名线程错位
 */

tracepoint:syscalls:sys_enter_open,
tracepoint:syscalls:sys_enter_openat          /* 一个程序挂多个事件 */
{
    @filename[tid] = args->filename;          /* 入口存参数（tid 为 key） */
}

tracepoint:syscalls:sys_exit_open,
tracepoint:syscalls:sys_exit_openat
/@filename[tid]/                              /* 过滤器：map 里存在才执行 */
{
    $ret = args->ret;
    $fd = $ret > 0 ? $ret : -1;
    $errno = $ret > 0 ? 0 : -$ret;
    printf("%-6d %-16s %4d %3d %s\n", pid, comm, $fd, $errno, str(@filename[tid]));
    delete(@filename[tid]);
}

END { clear(@filename); }
