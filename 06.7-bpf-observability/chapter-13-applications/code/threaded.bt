#!/usr/bin/env bpftrace
/* threaded.bt — 按线程采样 CPU 占用（02-ch13 §3 块3）
 *
 * 用法: sudo bpftrace threaded.bt <PID>
 * 每秒打印一轮 [comm, tid] → 样本数（99 样本 ≈ 100% 一个核）
 */

BEGIN
{
    if (!$1) { printf("USAGE: threaded.bt PID\n"); exit(); }
    printf("Sampling PID %d threads at 99 Hertz. Ctrl-C to end.\n", $1);
}

profile:hz:99 /pid == $1/
{
    @[comm, tid] = count();
}

interval:s:1
{
    time();
    print(@);
    clear(@);
}
