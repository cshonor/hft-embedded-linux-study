#!/usr/bin/env bpftrace
/* session-forensics.bt — 会话取证：进程树后代的 write 内容（02-ch11 §4 块5）
 *
 * 思路：sched_process_fork 把每个新 child_pid 记入 @descendent；
 * 之后这些 pid 的 write(2) 内容全部打印——
 * 从某个父进程（如 sshd/bash）开始的整个会话键盘/输出流。
 *
 * ⚠ 这是入侵检测/取证工具，也是隐私边界示例：
 *   能看到别人敲的每个字符——只在自己有授权的系统上用。
 *
 * 用法: sudo bpftrace session-forensics.bt
 */

tracepoint:sched:sched_process_fork
{
    @descendent[args->child_pid] = 1;
}

tracepoint:syscalls:sys_enter_write
/@descendent[pid]/
{
    printf("%s", str(args->buf, args->count));
}
