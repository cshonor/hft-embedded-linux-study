#!/usr/bin/env bpftrace
/* rename-exchange-watch.bt — RENAME_EXCHANGE 监控与管控（02-ch11 §1 块1/2）
 *
 * RENAME_EXCHANGE(flags=2)：原子交换两个文件名——持久化工具（如 etcd、
 * 配置写入器）的"安全替换"手法，也是检测未授权写的好钩子。
 *
 * 用法:
 *   观测版: sudo bpftrace rename-exchange-watch.bt
 *   管控版（杀进程）: sudo bpftrace --unsafe rename-exchange-watch.bt kill
 *     —— signal() 是 --unsafe 功能：bpftrace 不只是观测，还能主动处置
 */

tracepoint:syscalls:sys_enter_renameat2 /args->flags == 2/
{
    time();
    printf("%s RENAME_EXCHANGE %s <-> %s\n", comm,
           str(args->oldname), str(args->newname));

    if ($1 == 1) {
        printf("killing PID %d %s\n", pid, comm);
        signal(9);          /* --unsafe 模式下的主动防御 */
    }
}
