#!/usr/bin/env bpftrace
/* workq-latency.bt — workqueue 工作函数耗时（02-ch14 §7 块7）
 *
 * workqueue 是内核"延后干活"的机制；工作函数慢 = 它负责的那摊子事都慢
 * （如 NET_RX 的 napi、块层的 kblockd）。args->function 是工作函数指针，
 * ksym() 译名——按函数名聚合耗时。
 *
 * 用法: sudo bpftrace workq-latency.bt
 */

tracepoint:workqueue:workqueue_execute_start
{
    @start[tid] = nsecs;
    @wqfunc[tid] = args->function;
}

tracepoint:workqueue:workqueue_execute_end
/@start[tid]/
{
    @us[ksym(@wqfunc[tid])] = hist(nsecs - @start[tid]);
    delete(@start[tid]);
    delete(@wqfunc[tid]);
}

END
{
    clear(@start); clear(@wqfunc);
}
