#!/usr/bin/env bpftrace
/* slab-name.bt — 按 slab cache 名统计分配（02-ch14 §6 块5）
 *
 * kmem_cache_alloc 的 arg0 是 kmem_cache*，->name 就是 slabtop 里那些名字
 * （kmalloc-4k、inode_cache、dentry、TCP……）——比 slabtop 更细（带调用方上下文）。
 *
 * 用法: sudo bpftrace slab-name.bt
 */

#include <linux/mm.h>
#include <linux/slab.h>
#ifdef CONFIG_SLUB
#include <linux/slub_def.h>
#else
#include <linux/slab_def.h>
#endif

kprobe:kmem_cache_alloc
{
    $cachep = (struct kmem_cache *)arg0;
    @[str($cachep->name)] = count();
}

interval:s:1
{
    time();
    print(@);
    clear(@);
}
