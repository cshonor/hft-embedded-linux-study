#!/usr/bin/env bpftrace
/* loadavg.bt — kaddr 读内核 loadavg（02-ch14 §4 块1）
 *
 * avenrun 是内核定点数（11 位小数）数组：load1/load5/load15。
 * kaddr() 把内核符号变成可读地址——"从用户态程序读内核全局变量"。
 *
 * 用法: sudo bpftrace loadavg.bt
 */

interval:s:1
{
    $avenrun = kaddr("avenrun");
    $load1 = *$avenrun;
    $load5 = *($avenrun + 8);
    $load15 = *($avenrun + 16);
    time("%H:%M:%S");
    printf("load averages: %d.%02d %d.%02d %d.%02d\n",
        $load1 >> 11, (($load1 & ((1 << 11) - 1)) * 100) >> 11,
        $load5 >> 11, (($load5 & ((1 << 11) - 1)) * 100) >> 11,
        $load15 >> 11, (($load15 & ((1 << 11) - 1)) * 100) >> 11);
}
