#!/usr/bin/env bpftrace
/* numa-migrate.bt — NUMA 页迁移耗时（02-ch14 §6 块6）
 *
 * migrate_misplaced_page = NUMA balancing 把"放错节点"的页搬回家——
 * 搬页期间访问该页的线程在等。频繁发生 = NUMA 绑定没做好（→ 06.6/ch07）。
 *
 * 用法: sudo bpftrace numa-migrate.bt
 * 输出: 每秒一行 [次数, 总耗时ms]
 */

kprobe:migrate_misplaced_page
{
    @start[tid] = nsecs;
}

kretprobe:migrate_misplaced_page /@start[tid]/
{
    $dur = nsecs - @start[tid];
    @ns += $dur;
    @num++;
    delete(@start[tid]);
}

interval:s:1
{
    time();
    printf("%18d %18d\n", @num, @ns / 1000000);
    delete(@num);
    delete(@ns);
}
