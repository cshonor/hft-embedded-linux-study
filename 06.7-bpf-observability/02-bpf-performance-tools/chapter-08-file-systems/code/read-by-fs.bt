#!/usr/bin/env bpftrace
/* read-by-fs.bt — 按文件系统类型统计 vfs_read（02-ch08 §10 块2，可选练习答案）
 *
 * file->f_inode->i_sb->s_type->name：从 file 结构体拿到文件系统类型名
 * ——ext4/tmpfs/nfs/overlay 的读量分布一眼可见（容器环境的 overlay 开销量化）。
 *
 * 用法: sudo bpftrace read-by-fs.bt
 */

#include <linux/fs.h>

kprobe:vfs_read
{
    $fs = ((struct file *)arg0)->f_inode->i_sb->s_type->name;
    @[str($fs)] = count();
}
