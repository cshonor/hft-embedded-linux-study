#!/usr/bin/env bpftrace
/* threadsnoop.bt — 线程创建追踪（02-ch13 §2 块2）
 *
 * pthread_create 的 arg2 是线程入口函数地址，usym() 译成名字——
 * "谁在什么时候建了跑什么函数的线程"。
 *
 * 用法: sudo bpftrace threadsnoop.bt
 */

BEGIN
{
    printf("%-10s %-6s %-16s %s\n", "TIME(ms)", "PID", "COMM", "FUNC");
}

uprobe:/lib/x86_64-linux-gnu/libpthread.so.0:pthread_create
{
    printf("%-10u %-6d %-16s %s\n", elapsed / 1000000, pid, comm, usym(arg2));
}
