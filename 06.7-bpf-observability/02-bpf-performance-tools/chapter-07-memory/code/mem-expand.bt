#!/usr/bin/env bpftrace
/* mem-expand.bt — 指定进程的 brk/mmap 扩展追踪（02-ch07 §10 块1，可选练习）
 *
 * 用法: sudo bpftrace mem-expand.bt <pid>
 *   $1 = 目标 PID（bpftrace 位置参数）
 * 增量计算：sys_exit_brk 的 ret 是新 break——exit.ret - entry.brk = 本次扩展字节数
 */

tracepoint:syscalls:sys_enter_brk /pid == $1/
{
    printf("%s brk(0x%lx)\n", comm, args->brk);
    @last_brk[tid] = args->brk;
}

tracepoint:syscalls:sys_exit_brk /@last_brk[tid]/ && pid == $1/
{
    $grow = args->ret - @last_brk[tid];
    if ($grow > 0) {
        printf("  → 堆扩展 %ld 字节\n", $grow);
    }
    delete(@last_brk[tid]);
}

tracepoint:syscalls:sys_enter_mmap /pid == $1/
{
    printf("%s mmap len=%lu\n", comm, args->len);
}

END { clear(@last_brk); }
