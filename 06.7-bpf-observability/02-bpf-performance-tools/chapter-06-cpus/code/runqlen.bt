#!/usr/bin/env bpftrace
/* runqlen.bt — 运行队列长度直方图（02-ch06 §4 块10）
 *
 * runqlat 测"等多久"，runqlen 测"排多长的队"——饱和度的两个视角。
 * 99Hz 采样当前任务的 CFS 队列深度（nr_running - 1，减去自己）。
 *
 * 用法: sudo bpftrace runqlen.bt
 * 读数: 持续 >核数 = 超载；HFT 热核应恒为 0
 */

#include <linux/sched.h>

/* cfs_rq 只需 nr_running 字段，用部分定义避免拉整个 sched.h 的依赖链 */
struct cfs_rq_partial {
    struct load_weight load;
    unsigned long runnable_weight;
    unsigned int nr_running;
};

profile:hz:99
{
    $task = (struct task_struct *)curtask;
    $my_q = (struct cfs_rq_partial *)$task->se.cfs_rq;
    $len = $my_q->nr_running;
    $len = $len > 0 ? $len - 1 : 0;   /* 减去正在运行的自己 */
    @runqlen = lhist($len, 0, 100, 1);
}

END
{
    clear(@runqlen);
}
