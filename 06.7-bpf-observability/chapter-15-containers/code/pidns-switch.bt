#!/usr/bin/env bpftrace
/* pidns-switch.bt — PID 命名空间切换计数（02-ch15 §4 块3，书上 pidnss 的 bpftrace 版）
 *
 * finish_task_switch 时比较 prev/curr 的 PID namespace：
 * 不同 = CPU 从一个容器（或宿主机）切到另一个——容器边界的调度穿越画像。
 * nodename 就是容器的主机名（k8s 里 = pod 名）。
 *
 * 用法: sudo bpftrace pidns-switch.bt
 */

#include <linux/sched.h>
#include <linux/nsproxy.h>
#include <linux/utsname.h>
#include <linux/pid_namespace.h>

kprobe:finish_task_switch
{
    $prev = (struct task_struct *)arg0;
    $curr = (struct task_struct *)curtask;
    $prev_pidns = $prev->nsproxy->pid_ns_for_children->ns.inum;
    $curr_pidns = $curr->nsproxy->pid_ns_for_children->ns.inum;
    if ($prev_pidns != $curr_pidns) {
        @[$prev_pidns, $prev->nsproxy->uts_ns->name.nodename] = count();
    }
}
