#!/usr/bin/env bpftrace
/* blkthrot.bt — 块 I/O 节流按 cgroup 统计（02-ch15 §5 块4，书上 blkthrot 的 bpftrace 版）
 *
 * blk_throtl_bio 是 blk-cgroup 节流的判定函数：返回非零 = 这次 bio 被节流。
 * 按 css.id（cgroup 标识）聚合被节流/未被节流次数——
 * 容器"磁盘慢"时先查是不是被自己 cgroup 限的（→ 06.6/ch11 cgroup 节流）。
 *
 * 用法: sudo bpftrace blkthrot.bt
 */

#include <linux/cgroup-defs.h>
#include <linux/blk-cgroup.h>

kprobe:blk_throtl_bio
{
    @blkg[tid] = arg1;
}

kretprobe:blk_throtl_bio
/@blkg[tid]/
{
    $blkg = (struct blkcg_gq *)@blkg[tid];
    if (retval) {
        @throttled[$blkg->blkcg->css.id] = count();
    } else {
        @not_throttled[$blkg->blkcg->css.id] = count();
    }
    delete(@blkg[tid]);
}

END
{
    clear(@blkg); clear(@throttled); clear(@not_throttled);
}
