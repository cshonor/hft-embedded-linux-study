#!/usr/bin/env bpftrace
/* blkthrot.bt — 块 I/O 节流事件统计（02-ch15 §5 块4，书上 blkthrot 的 bpftrace 版）
 *
 * ⚠ 内核 7.0 适配（2026-10 本机实测）：原版 kprobe:blk_throtl_bio 已不存在
 * （blk-cgroup 深度重构，throttle 逻辑内联进 submit 路径）。可 attach 的
 * 替代符号是 throtl_qnode_add_bio——"bio 被挂入限流队列"的瞬间，
 * 即"被节流"事件本身（未节流对照在重构后的内核里已没有干净钩子，
 * 故只统计节流侧；cgroup 归属从 bio 反查代价高，按 comm 聚合已够用）。
 *
 * 容器"磁盘慢"时先查是不是被自己 cgroup 限的（→ 06.6.5/ch11 cgroup 节流）。
 *
 * 用法: sudo bpftrace blkthrot.bt
 */

BEGIN
{
    printf("Tracing blk-throttle queue events. Ctrl-C to end.\n");
}

kprobe:throtl_qnode_add_bio
{
    @throttled_by_comm[comm] = count();
    @throttled_total = count();
}

END
{
    clear(@throttled_by_comm); clear(@throttled_total);
}
