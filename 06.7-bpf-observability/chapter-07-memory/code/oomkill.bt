#!/usr/bin/env bpftrace
/* oomkill.bt — OOM 杀手现场追踪（02-ch07 §3 块5，书上 oomkill 的 bpftrace 版）
 *
 * OOM 杀进程是"事后才知道"的事故；这个程序在 oom_kill_process 触发时
 * 立即打印：谁触发的、杀了谁、占多少页、当时 loadavg。
 *
 * 用法: sudo bpftrace oomkill.bt（常开，等事故发生）
 */

/* 不 #include <linux/oom.h>：同上——BTF 提供 struct oom_control 布局（2026-10 实测修复） */

BEGIN
{
    printf("Tracing oom_kill_process(... Hit Ctrl-C to end.\n");
}

kprobe:oom_kill_process
{
    $oc = (struct oom_control *)arg1;
    time("%H:%M:%S");
    printf("Triggered by PID %d (\"%s\"), ", pid, comm);
    printf("OOM kill of PID %d (\"%s\"), %d pages, loadavg: ",
           $oc->chosen->pid, $oc->chosen->comm, $oc->totalpages);
    cat("/proc/loadavg");
}
