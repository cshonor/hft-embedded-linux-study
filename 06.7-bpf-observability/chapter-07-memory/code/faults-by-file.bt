#!/usr/bin/env bpftrace
/* faults-by-file.bt — 按文件统计缺页（02-ch07 §6 块11）
 *
 * mmap 的文件首次触碰才缺页；这个程序回答"缺页都在摸哪些文件"——
 * 大文件 mmap 扫描（行情回放）的缺页热点一眼可见。
 *
 * 用法: sudo bpftrace faults-by-file.bt
 * 注意: vma->vm_file 为空（匿名页）时 str 会打空串——匿名页缺页归到空键
 */

#include <linux/mm.h>

kprobe:handle_mm_fault
{
    $vma = (struct vm_area_struct *)arg0;
    $file = $vma->vm_file->f_path.dentry->d_name.name;
    @[str($file)] = count();
}
