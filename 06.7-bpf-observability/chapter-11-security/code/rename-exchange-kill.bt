#!/usr/bin/env bpftrace
/* rename-exchange-kill.bt — RENAME_EXCHANGE 管控版：发现即杀（02-ch11 §1 块2）
 *
 * signal() 是 --unsafe 功能：bpftrace 不只是观测，还能主动处置。
 * （原与观测版同文件，但 signal() 编译期就要求 --unsafe，会拖累观测版，
 *   故拆出——2026-10 本机实测修复）
 *
 * 用法: sudo bpftrace --unsafe rename-exchange-kill.bt
 */

tracepoint:syscalls:sys_enter_renameat2 /args->flags == 2/
{
    time();
    printf("%s RENAME_EXCHANGE %s <-> %s — killing PID %d\n", comm,
           str(args->oldname), str(args->newname), pid);
    signal(9);          /* --unsafe 模式下的主动防御 */
}
