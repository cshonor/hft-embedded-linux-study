#!/usr/bin/env bpftrace
/* rename-exchange-watch.bt — RENAME_EXCHANGE 观测（02-ch11 §1 块1）
 *
 * RENAME_EXCHANGE(flags=2)：原子交换两个文件名——持久化工具（如 etcd、
 * 配置写入器）的"安全替换"手法，也是检测未授权写的好钩子。
 *
 * 用法: sudo bpftrace rename-exchange-watch.bt
 * 管控版（发现即杀进程）见同目录 rename-exchange-kill.bt（需 --unsafe）——
 * signal() 是 unsafe 函数，编译期就会被拒，故拆成两个文件（2026-10 实测）。
 */

tracepoint:syscalls:sys_enter_renameat2 /args->flags == 2/
{
    time();
    printf("%s RENAME_EXCHANGE %s <-> %s\n", comm,
           str(args->oldname), str(args->newname));
}
