#!/usr/bin/env bpftrace
/* fork-trace.bt — 进程创建追踪（02-ch06 §11 块2，可选练习参考答案）
 *
 * sched_process_fork 一个 tracepoint 天然覆盖 fork/clone/vfork 全部路径
 * ——不用分别挂三个 syscall。
 *
 * 用法: sudo bpftrace fork-trace.bt
 */

tracepoint:sched:sched_process_fork
{
    printf("%s pid=%d child=%d\n", comm, pid, args->child_pid);
}
