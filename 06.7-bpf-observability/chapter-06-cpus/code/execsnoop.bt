#!/usr/bin/env bpftrace
/* execsnoop.bt — 新进程追踪（含参数）（02-ch06 §3 块8，书上 execsnoop 的 bpftrace 版）
 *
 * 用法: sudo bpftrace execsnoop.bt
 * 输出: TIME(ms) PID ARGS（自 bpftrace 启动以来的毫秒时间戳）
 */

BEGIN
{
    printf("%-10s %-5s %s\n", "TIME(ms)", "PID", "ARGS");
}

tracepoint:syscalls:sys_enter_execve
{
    printf("%-10u %-5d", elapsed / 1000000, pid);
    join(args->argv);   /* argv 是 char**，join 按 8B 步长解引用直到 NULL，空格拼接 */
}
