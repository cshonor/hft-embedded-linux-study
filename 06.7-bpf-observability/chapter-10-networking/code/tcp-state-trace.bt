#!/usr/bin/env bpftrace
/* tcp-state-trace.bt — TCP 状态迁移追踪（02-ch10 §10 块3，练习答案）
 *
 * inet_sock_set_state 是稳定 ABI（tracepoint），不怕内核函数改名/内联；
 * 状态迁移的瞬间就是事件：CLOSE(7)→SYN_SENT(2) = 发起连接。
 *
 * ⚠ 上下文陷阱（笔记 10.1.4 错误一）：
 *   状态迁移发生在软中断上下文——pid/comm 不可靠（看到的是被中断的进程）！
 *   需要 pid 就得在别处（进程上下文，如 tcp_v4_connect）以 sock 为键补记。
 *
 * 用法: sudo bpftrace tcp-state-trace.bt
 */

/* 不 #include <net/tcp_states.h>（内核 7.0 头 static_assert 解析失败，2026-10 实测）；
 * TCP 状态号写字面量：SYN_SENT=2, CLOSE=7 */

tracepoint:sock:inet_sock_set_state
/args->newstate == 2/      /* TCP_SYN_SENT */
{
    /* 发起连接的瞬间（SYN_SENT=2）。此处 args->skaddr 是 sock 指针，
     * 可缓存五元组；pid 不可靠——见文件头注释 */
    printf("connect initiated: sk=%llx (pid 字段在软中断上下文不可信)\n",
           args->skaddr);
    @syn_sent[lport(args->sport)] = count();
}

tracepoint:sock:inet_sock_set_state
/args->newstate == 7/      /* TCP_CLOSE */
{
    @closed = count();
}

END { clear(@syn_sent); clear(@closed); }
