#!/usr/bin/env bpftrace
/* sock-rxtx.bt — socket 收发按线程拆分 + 字节画像（02-ch10 §10 块1/2，练习答案）
 *
 * 改进点（vs 书上原工具）：
 *   ① 加 pid 维度——多线程进程（Java/Go）同 comm 混在一起的拆分
 *   ② stats() 一次出 count+average+total（吞吐画像）；
 *     要看分布形状（多峰/长尾）才换 hist()
 *
 * 用法: sudo bpftrace sock-rxtx.bt
 */

kprobe:sock_recvmsg { @rx[pid, comm] = count(); }
kprobe:sock_sendmsg { @tx[pid, comm] = count(); }

kretprobe:sock_recvmsg /retval > 0 && retval < 0x7fffffff/
{
    @rxbytes = stats(retval);     /* count + average + total 一次出全 */
}

END
{
    clear(@rx); clear(@tx); clear(@rxbytes);
}
